// la meme fonction appelee 300 fois (boucles courtes)
// -> le JIT par appels gagne, l'OSR ne sert a rien ici.
fn somme(n) {
    let i = 0;
    let s = 0;
    while (i <= n) {
        s = s + i;
        i = i + 1;
    }
    return s;
}
let total = 0;
let k = 0;
while (k < 300) {
    total = somme(200);
    k = k + 1;
}
print(total);