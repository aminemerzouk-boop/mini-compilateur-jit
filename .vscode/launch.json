{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug mlang (fib)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/mlang",
            "args": [
                "--jit=off",
                "${workspaceFolder}/tests/fib.mlang"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build"
        }
    ]
}